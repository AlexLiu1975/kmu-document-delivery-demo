rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validDocumentNumber(value) {
      return value is string && value.matches('^[0-9]{10}$');
    }

    function validEmployeeNumber(value) {
      return value is string && value.matches('^[0-9]{7}$');
    }

    function isStaffEmployee(value) {
      return value in ['1107054', '1115034'];
    }

    function staffSession() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(/databases/$(database)/documents/staffAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffAdmins/$(request.auth.uid)).data.enabled == true
        && isStaffEmployee(get(/databases/$(database)/documents/staffAdmins/$(request.auth.uid)).data.employeeNumber);
    }

    function staffSessionFor(employeeNumber) {
      return staffSession()
        && get(/databases/$(database)/documents/staffAdmins/$(request.auth.uid)).data.employeeNumber == employeeNumber;
    }

    function validOptionalEmployeeNumber(value) {
      return value == '' || validEmployeeNumber(value);
    }

    function statusCode(value) {
      return value == '已收文' || value == '事務組簽收' ? 'R'
        : value == '已退文' ? 'B'
        : value == '已歸檔' ? 'A'
        : value == '未收文' || value == '已送達' ? 'P' : value;
    }

    function validStatus(value) {
      return statusCode(value) in ['P', 'R', 'B', 'A'];
    }

    function validDocument(data, documentNumber) {
      return data.keys().hasOnly([
          'documentNumber', 'year', 'typeCode', 'serial', 'status',
          'assignee', 'latestRejectionReason', 'latestRejectionActor',
          'createdAt', 'updatedAt', 'revision', 'returnCount',
          'lastReturnDate', 'receivedAt', 'archivedAt'
        ])
        && validDocumentNumber(documentNumber)
        && data.documentNumber == documentNumber
        && data.year is string
        && data.year.matches('^[0-9]{3}$')
        && data.typeCode is string
        && data.typeCode.matches('^[0-9]{2,3}$')
        && data.serial is string
        && data.serial.matches('^[0-9]{4,5}$')
        && data.documentNumber == data.year + data.typeCode + data.serial
        && validStatus(data.status)
        && validEmployeeNumber(data.assignee)
        && data.latestRejectionReason is string
        && data.latestRejectionReason.size() <= 200
        && validOptionalEmployeeNumber(data.latestRejectionActor)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.revision is int
        && data.revision >= 1
        && (!('returnCount' in data) || (data.returnCount is int && data.returnCount >= 0))
        && (!('lastReturnDate' in data) || data.lastReturnDate is timestamp)
        && (!('receivedAt' in data) || data.receivedAt is timestamp)
        && (!('archivedAt' in data) || data.archivedAt is timestamp);
    }

    function validTransition(oldStatus, newStatus) {
      return (statusCode(oldStatus) == 'P' && statusCode(newStatus) == 'R')
        || (statusCode(oldStatus) == 'R' && statusCode(newStatus) == 'B')
        || (statusCode(oldStatus) == 'B' && statusCode(newStatus) == 'R')
        || (statusCode(oldStatus) == 'R' && statusCode(newStatus) == 'A');
    }

    function immutableDocumentFields() {
      return request.resource.data.documentNumber == resource.data.documentNumber
        && request.resource.data.year == resource.data.year
        && request.resource.data.typeCode == resource.data.typeCode
        && request.resource.data.serial == resource.data.serial
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validEvent(data, documentNumber) {
      return data.keys().hasOnly([
          'documentNumber', 'action', 'oldStatus', 'newStatus',
          'reason', 'actor', 'authUid', 'occurredAt'
        ])
        && data.documentNumber == documentNumber
        && validDocumentNumber(data.documentNumber)
        && validEmployeeNumber(data.actor)
        && data.authUid == request.auth.uid
        && data.occurredAt is timestamp
        && data.reason is string
        && data.reason.size() <= 200
        && (
          (data.action == '承辦人收文'
            && (data.oldStatus == '' || statusCode(data.oldStatus) == 'P')
            && statusCode(data.newStatus) == 'R'
            && data.reason == '')
          || (data.action == '退文'
            && statusCode(data.oldStatus) == 'R'
            && statusCode(data.newStatus) == 'B'
            && data.reason.size() > 0
            && isStaffEmployee(data.actor))
          || (data.action == '承辦人重新收文'
            && statusCode(data.oldStatus) == 'B'
            && statusCode(data.newStatus) == 'R'
            && data.reason == '')
          || (data.action == '歸檔'
            && statusCode(data.oldStatus) == 'R'
            && statusCode(data.newStatus) == 'A'
            && data.reason == ''
            && isStaffEmployee(data.actor))
        );
    }

    match /documents/{documentNumber} {
      allow get: if signedIn();
      allow list: if staffSession();
      allow create: if staffSessionFor(request.resource.data.assignee)
        && validDocument(request.resource.data, documentNumber)
        && statusCode(request.resource.data.status) in ['P', 'R']
        && request.resource.data.revision == 1
        && request.resource.data.latestRejectionReason == ''
        && request.resource.data.latestRejectionActor == '';
      allow update: if staffSession()
        && validDocument(request.resource.data, documentNumber)
        && immutableDocumentFields()
        && validTransition(resource.data.status, request.resource.data.status)
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;

      match /events/{eventId} {
        allow read: if staffSession();
        allow create: if staffSessionFor(request.resource.data.actor)
          && validEvent(request.resource.data, documentNumber);
        allow update, delete: if false;
      }
    }

    function staffReportAdmin() {
      return staffSession();
    }
    match /staffAdmins/{uid} {
      allow get: if staffReportAdmin() && request.auth.uid == uid;
      allow list, write: if false;
    }
    function reportAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/reportAdmins/$(request.auth.token.email))
        && get(/databases/$(database)/documents/reportAdmins/$(request.auth.token.email)).data.enabled == true;
    }
    match /reportAdmins/{email} {
      allow get: if reportAdmin() && request.auth.token.email == email;
      allow list, write: if false;
    }

    // These records contain employee numbers and full IPs. Read through project IAM only.
    match /usageRecords/{recordId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['employeeNumber','documentNumber','ip','ipStatus','visitorId','sessionId','authUid','action','result','errorCode','occurredAt'])
        && request.resource.data.keys().hasOnly(['employeeNumber','documentNumber','ip','ipStatus','visitorId','sessionId','authUid','action','result','errorCode','occurredAt'])
        && request.resource.data.authUid == request.auth.uid
        && validOptionalEmployeeNumber(request.resource.data.employeeNumber)
        && (request.resource.data.documentNumber == '' || validDocumentNumber(request.resource.data.documentNumber))
        && request.resource.data.ip is string && request.resource.data.ip.size() <= 64
        && ((request.resource.data.ipStatus == 'unavailable' && request.resource.data.ip == '')
          || (request.resource.data.ipStatus == 'available' && request.resource.data.ip.size() > 0))
        && request.resource.data.visitorId is string && request.resource.data.visitorId.size() > 0 && request.resource.data.visitorId.size() <= 100
        && request.resource.data.sessionId is string && request.resource.data.sessionId.size() > 0 && request.resource.data.sessionId.size() <= 100
        && request.resource.data.action in ['PAGE_VIEW','LOGIN','QUERY','RECEIVE','REJECT','ARCHIVE']
        && request.resource.data.result in ['success','not_found','failure']
        && request.resource.data.errorCode is string && request.resource.data.errorCode.size() <= 100
        && request.resource.data.occurredAt == request.time;
      allow read: if staffReportAdmin();
      allow update, delete: if false;
    }

    match /{path=**}/events/{eventId} {
      allow read: if staffSession();
    }
  }
}
